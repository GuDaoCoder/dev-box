{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devbox.local/schemas/plugin-manifest.schema.json",
  "title": "DevBox Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "engines",
    "type",
    "entry",
    "activationEvents",
    "permissions",
    "locales",
    "contributes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^devbox\\.[a-z0-9.-]+$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 240 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "keyId": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devbox", "pluginApi"],
      "properties": {
        "devbox": { "type": "string", "minLength": 1, "maxLength": 40 },
        "pluginApi": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "type": { "enum": ["ui", "native"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main"],
      "properties": {
        "main": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+\\.html$",
          "maxLength": 200
        }
      }
    },
    "activationEvents": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "uniqueItems": true,
      "maxItems": 32
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "clipboard:read",
          "clipboard:write",
          "java:execute",
          "storage:read",
          "storage:write"
        ]
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+\\.json$",
        "maxLength": 200
      },
      "propertyNames": { "enum": ["zh-CN", "en-US"] }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["views"],
      "properties": {
        "views": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "titleKey", "icon", "order", "category"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
              "titleKey": { "type": "string", "minLength": 3, "maxLength": 120 },
              "icon": {
                "enum": ["binary", "box", "braces", "clock", "code", "fingerprint", "plug"]
              },
              "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "category": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "order"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
                  "title": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["zh-CN", "en-US"],
                    "properties": {
                      "zh-CN": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "en-US": { "type": "string", "minLength": 1, "maxLength": 80 }
                    }
                  },
                  "order": { "type": "integer", "minimum": 0, "maximum": 10000 }
                }
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "titleKey"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 120 },
              "titleKey": { "type": "string", "minLength": 3, "maxLength": 120 }
            }
          }
        }
      }
    }
  }
}
