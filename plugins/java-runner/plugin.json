{
  "schemaVersion": 1,
  "id": "devbox.java-snippet-runner",
  "name": "Java Snippet Runner",
  "description": "Run Java code snippets with syntax highlighting through a controlled JShell host.",
  "version": "0.1.0",
  "publisher": {
    "id": "devbox",
    "name": "DevBox Official"
  },
  "engines": {
    "devbox": ">=0.1.0, <0.2.0",
    "pluginApi": "^1.0.0"
  },
  "type": "ui",
  "entry": {
    "main": "dist/index.html"
  },
  "activationEvents": ["onView:java-snippet-runner"],
  "permissions": ["java:execute"],
  "locales": {
    "zh-CN": "locales/zh-CN.json",
    "en-US": "locales/en-US.json"
  },
  "contributes": {
    "views": [
      {
        "id": "java-snippet-runner",
        "titleKey": "javaRunner.title",
        "icon": "code",
        "order": 10,
        "category": {
          "id": "languages",
          "title": {
            "zh-CN": "编程语言",
            "en-US": "Languages"
          },
          "order": 50
        }
      }
    ]
  }
}
